rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Restaurants + menu items: public read, admin-only write.
    match /restaurants/{restaurantId} {
      allow read: if true;
      // Admin full write; baaki users sirf aggregate rating fields update kar sakte hain
      // (review submit karne ke baad rating recalculate hoti hai).
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'ratingCount']));

      match /menu/{itemId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Reviews: public read, har user apna ek review likh/edit/delete kar sakta hai
      // (document ID = userId, isliye dobara likhne se update ho jata hai).
      match /reviews/{userId} {
        allow read: if true;
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow update: if isSignedIn() && request.auth.uid == userId;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /users/{userId} {
      // Profile self read/write; admin can read any profile.
      allow read: if isOwner(userId) || isAdmin();
      // role field admin hi set kar sakta hai
      allow create: if isOwner(userId) && request.resource.data.role == 'customer';
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();

      match /addresses/{addressId} {
        allow read, write: if isOwner(userId);
      }

      match /carts/{cartId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /orders/{orderId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Most-sold leaderboard: public read (homepage pe dikhta hai), lekin
    // counters ko sirf increment karna allowed hai — reset/decrease nahi.
    // Fields bhi restricted hain taaki koi arbitrary data inject na kare.
    match /itemSales/{saleId} {
      allow read: if true;

      // Admin seed ke liye full control (demo counters bade hote hain).
      allow create, delete: if isAdmin();

      // Normal user: naya counter document, sane range me.
      allow create: if isSignedIn()
        && saleId.split('__').size == 2
        && request.resource.data.keys().hasOnly([
             'restaurantId', 'restaurantSlug', 'restaurantName', 'itemId', 'itemName',
             'imageUrl', 'price', 'soldCount', 'updatedAt'
           ])
        && request.resource.data.soldCount is int
        && request.resource.data.soldCount > 0
        && request.resource.data.soldCount <= 20;

      // Update: sirf soldCount badhna allowed, decrease nahi.
      allow update: if isAdmin() || (isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'soldCount', 'restaurantName', 'restaurantSlug', 'imageUrl', 'price', 'updatedAt'
           ])
        && request.resource.data.soldCount is int
        && request.resource.data.soldCount > resource.data.soldCount);
    }
  }
}