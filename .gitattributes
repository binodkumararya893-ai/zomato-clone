# Normalize line endings in the repository
* text=auto eol=lf

# Windows-only
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.zip binary
*.pdf binary

# Lockfiles — keep as generated
package-lock.json -diff linguist-generated=true